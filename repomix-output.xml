  username,
  email,
  phone,
  bedrooms,
  bathrooms,
  serviceType,
  orderTime,
  price,
}: Props) {
  const previewText = `Quote Request: ${username} (${bedrooms}BR/${bathrooms}BA)`

  return (
    <Html>
      <Head />
      <Preview>{previewText}</Preview>
      <Body style={main}>
