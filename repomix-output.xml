import {
  Body,
  Container,
  Head,
  Html,
  Preview,
  Section,
  Text,
  Link,
  Hr,
} from "@react-email/components"

interface Props {
  username: string
  email: string
  phone: string
  bedrooms: string
  bathrooms: string
  serviceType: string
  orderTime: string
  price: string
