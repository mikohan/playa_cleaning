@layer base {

- {
  /_ @apply border-border outline-ring/50; _/
  }
  body {
  @apply bg-background font-sans text-foreground;
  }
  html {
  /_ @apply font-sans; _/
  @apply font-jakarta;
  }
  }

.radial-gradient {
background:
radial-gradient(
circle at 50% 0%,
rgba(250, 250, 250, 0.05) 0%,
transparent 60%
),
rgba(0, 11, 238, 0.7);
}
.linear-mask {
mask-image: linear-gradient(
-75deg,
white calc(var(--x) + 20%),
transparent calc(var(--x) + 30%),
white calc(var(--x) + 100%)
);
}

.linear-overlay {
background-image: linear-gradient(
-75deg,
rgba(255, 255, 255, 0.1) calc(var(--x) + 20%),
rgba(255, 255, 255, 0.6) calc(var(--x) + 25%),
rgba(255, 255, 255, 0.1) calc(var(--x) + 100%)
);
mask:
linear-gradient(black, black) content-box,
linear-gradient(black, black);
mask-composite: exclude;
}

.perks-ticker-image {
@apply h-14 w-auto opacity-70;
}

.nav-animation-underline {
@apply relative font-medium transition-colors duration-300 hover:text-secondary-foreground;

/_ The underline logic _/
@apply after:absolute after:-bottom-0.5 after:left-0 after:h-0.5 after:w-0 after:bg-secondary-foreground after:transition-all after:duration-300;

/_ Fixed the typo from 'over' to 'hover' _/
@apply hover:after:w-full;
}
/_ Styling the overlay/backdrop _/
dialog::backdrop {
background-color: rgba(0, 0, 0, 0.6);
backdrop-filter: blur(8px);
}

/_ The "Center-Everything" Reset _/
/_ globals.css _/

/_ Reset dialog browser defaults and center the content _/
dialog {
all: unset;
position: fixed;
inset: 0;
display: none;
width: 100vw;
height: 100vh;
align-items: center;
justify-content: center;
z-index: 999;
}

dialog[open] {
display: flex;
}

/_ Premium Backdrop Styling _/
dialog::backdrop {
background-color: rgba(0, 0, 0, 0.6);
backdrop-filter: blur(8px);
}
